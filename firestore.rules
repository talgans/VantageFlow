rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isMainSuperAdmin() {
      return isAuthenticated() && (request.auth.token.get('email', '') == 'talgans@gmail.com');
    }

    function isSuperAdmin() {
      return isAuthenticated() && (
        isMainSuperAdmin() ||
        request.auth.token.get('role', '') == 'superadmin'
      );
    }
    
    function isAdmin() {
      return isAuthenticated() && (
        isSuperAdmin() ||
        request.auth.token.get('role', '') == 'admin'
      );
    }
    
    function isManager() {
      return isAuthenticated() && (
        isAdmin() ||
        request.auth.token.get('role', '') == 'manager'
      );
    }
    
    // Check if user is project owner, superadmin, admin, or manager/member of the project
    function canUpdateProject(projectData) {
      return isAuthenticated() && (
        isSuperAdmin() ||
        isAdmin() ||
        projectData.get('ownerId', '') == request.auth.uid ||
        (projectData.get('memberUids', []) is list && request.auth.uid in projectData.get('memberUids', []))
      );
    }

    // RBAC + Privacy: Project can be read if public, if user is owner/member, or if SuperAdmin
    function canViewProject(projectData) {
      return isAuthenticated() && (
        isSuperAdmin() ||
        projectData.get('isPublic', false) == true ||
        projectData.get('ownerId', '') == request.auth.uid ||
        (projectData.get('memberUids', []) is list && request.auth.uid in projectData.get('memberUids', []))
      );
    }

    // Deletion:
    // 1. talgans@gmail.com can delete ANY project
    // 2. Other SuperAdmins can delete any project EXCEPT those created by talgans@gmail.com
    // 3. Project owner (manager/admin) can delete their own project
    function canDeleteProject(projectData) {
      return isAuthenticated() && (
        isMainSuperAdmin() ||
        (isSuperAdmin() && projectData.get('ownerEmail', '') != 'talgans@gmail.com') ||
        (isManager() && projectData.get('ownerId', '') == request.auth.uid)
      );
    }

    // Check if project is archived
    function isArchived(projectData) {
      return projectData.get('isArchived', false) == true;
    }

    // Check if update is unarchiving (setting isArchived to false)
    function isUnarchiving() {
      return request.resource.data.get('isArchived', false) == false && resource.data.get('isArchived', false) == true;
    }
    
    // Users collection
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isSuperAdmin() || 
                       (isAdmin() && request.resource.data.get('email', '') != 'talgans@gmail.com' && request.resource.data.get('role', '') != 'superadmin') || 
                       request.auth.uid == userId;
      allow update: if isSuperAdmin() || 
                       (isAdmin() && resource.data.get('email', '') != 'talgans@gmail.com' && resource.data.get('role', '') != 'superadmin') || 
                       request.auth.uid == userId;
      allow delete: if isSuperAdmin();
    }
    
    // Presence collection (heartbeat and online status)
    match /presence/{userId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && request.auth.uid == userId;
    }
    
    // Projects collection - RBAC and Privacy enforced
    match /projects/{projectId} {
      // Get: Read individual project doc if public, user is owner/member, or SuperAdmin
      allow get: if canViewProject(resource.data);

      // List: Queries matching array-contains on memberUids, isPublic == true, or SuperAdmin
      allow list: if isAuthenticated() && (
        isSuperAdmin() ||
        resource.data.isPublic == true ||
        request.auth.uid in resource.data.memberUids
      );
      
      // Create: Managers, Admins, and SuperAdmins can create projects
      allow create: if isManager();
      
      // Update: Owner, SuperAdmin, or assigned Admin can update, but NOT if archived (unless unarchiving)
      allow update: if canUpdateProject(resource.data) && 
                       (!isArchived(resource.data) || isUnarchiving());
      
      // Delete: Controlled by canDeleteProject
      allow delete: if canDeleteProject(resource.data);
    }
    
    // Invites collection (48-hour secure setup tokens managed via Cloud Functions)
    match /invites/{token} {
      allow read: if isAdmin();
      allow write: if false; // Cloud Functions (Admin SDK) manage all token lifecycle operations
    }
    
    // Force Logout collection (for role changes)
    match /forceLogout/{userId} {
      allow read: if isAuthenticated() && request.auth.uid == userId;
      allow create, update, delete: if isAdmin();
    }

    // Notifications
    match /notifications/{notificationId} {
      // User can read their own notifications (both get and list)
      // Client queries must filter by where('userId', '==', auth.uid)
      allow get: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow list: if isAuthenticated() && resource.data.userId == request.auth.uid;
      // User can mark their own notifications as read (update)
      allow update: if isAuthenticated() && resource.data.userId == request.auth.uid;
      // Cloud functions (admin SDK) bypass rules, so no create needed here unless client creates.
      allow create: if false; 
    }

    // Achievements - gamification points/badges (public for authenticated users)
    match /achievements/{achievementId} {
      // Any authenticated user can read achievements (displayed for team members)
      allow read: if isAuthenticated();
      // Creation: currently client-side 'achievementService' calls addDoc.
      allow create: if isAuthenticated();
      // Only admin can modify/delete history
      allow update, delete: if isAdmin();
    }

    // Role Permissions configuration
    match /rolePermissions/{docId} {
      // All authenticated users can read permissions (needed to check their role's capabilities)
      allow read: if isAuthenticated();
      // Only admins can modify permission configurations
      allow write: if isAdmin();
    }
  }
}
