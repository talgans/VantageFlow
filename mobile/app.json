{
  "expo": {
    "name": "VantageFlow",
    "slug": "vantageflow",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "vantageflow",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0f172a",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.vantageflow.app",
      "infoPlist": {
        "NSCameraUsageDescription": "VantageFlow uses the camera to attach deliverable photos to tasks and update profile avatars.",
        "NSPhotoLibraryUsageDescription": "VantageFlow needs access to your photos to attach deliverables and task progress images."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0f172a",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "package": "com.vantageflow.app",
      "permissions": [
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "NOTIFICATIONS"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#0f172a"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "VantageFlow requires access to your photo library to attach task deliverables.",
          "cameraPermission": "VantageFlow requires camera access to take photos of task deliverables."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}

